# Application
APP_NAME=GeoNexa Proxima
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# Storage (local Docker Compose defaults; replace for production)
DATABASE_URL=postgresql+asyncpg://geonexa:change-me@localhost:5432/geonexa
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=geonexa_items
QDRANT_PROFILE_COLLECTION=geonexa_profiles

# Embeddings: api or local
EMBEDDING_MODE=api
EMBEDDING_LOCAL_PATH=models/Qwen3-Embedding-4B
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_API_BASE_URL=http://localhost:8001/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_DIMENSIONS=2560
EMBEDDING_BATCH_SIZE=16

# Reranker: api or local
RERANKER_MODE=api
RERANKER_LOCAL_PATH=models/Qwen3-Reranker-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_API_URL=http://localhost:8002/rerank
RERANKER_API_KEY=replace-me
RERANKER_BATCH_SIZE=16

# OpenAI-compatible LLM endpoints
LIGHT_LLM_BASE_URL=https://api.openai.com/v1
LIGHT_LLM_API_KEY=replace-me
LIGHT_LLM_MODEL=gpt-4.1-mini
HEAVY_LLM_BASE_URL=https://api.openai.com/v1
HEAVY_LLM_API_KEY=replace-me
HEAVY_LLM_MODEL=gpt-5
LLM_TIMEOUT_SECONDS=120

# Telegram (comma-separated numeric user IDs)
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Source identities and optional API keys
OPENALEX_EMAIL=researcher@example.com
CROSSREF_EMAIL=researcher@example.com
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
HF_TOKEN=

# Relevance profile and pipeline thresholds
TAXONOMY_PATH=config/taxonomy.yaml
SEMANTIC_THRESHOLD=0.45
DIGEST_SCORE_THRESHOLD=6.5
DEEP_ANALYSIS_THRESHOLD=8.0
ALERT_SCORE_THRESHOLD=9.0
COLLECTION_LOOKBACK_HOURS=30
MAX_ITEMS_PER_SOURCE=200
PERSONALIZATION_CANDIDATE_LIMIT=100
PERSONAL_SEMANTIC_WEIGHT=0.40
PERSONAL_RERANKER_WEIGHT=0.25
PERSONAL_GLOBAL_WEIGHT=0.25
PERSONAL_INTEREST_WEIGHT=0.10
