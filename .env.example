# =============================================================================
# GeoNexa Proxima — шаблон окружения. Скопируй в .env и подставь реальные значения.
# cp .env.example .env
# =============================================================================
# Значения ниже — дефолты. Почти всё из этого файла переопределяется в админке
# (таблица app_settings): env задаёт стартовое значение, БД — эффективное.
# Строго env-only: секреты подключения к БД, ADMIN_*, ENCRYPTION_KEY.
# =============================================================================

# --- Приложение --------------------------------------------------------------
APP_NAME=GeoNexa Proxima
ENVIRONMENT=development
LOG_LEVEL=INFO
# Пусто — по окружению: в production JSON, в разработке — человекочитаемо.
LOG_JSON=
TIMEZONE=Europe/Moscow
# Внешний адрес сервиса. Из него собирается вебхук, если
# TELEGRAM_WEBHOOK_URL не задан явно. localhost вебхуком не станет:
# Telegram до него не достучится, и регистрация пропускается.
PUBLIC_BASE_URL=http://localhost:8000

# --- PostgreSQL: управляемая БД Timeweb Cloud --------------------------------
# Пароль в URL обязан быть percent-encoded, иначе '{', '+', '$' и '?' ломают
# разбор DSN, а '$' ещё и интерполируется docker compose.
#   {  -> %7B     +  -> %2B     $  -> %24     ?  -> %3F
# asyncpg НЕ понимает параметр sslmode в строке подключения: TLS передаётся
# через ssl.SSLContext в connect_args (см. db/session.py). Поэтому в
# DATABASE_URL никаких ?sslmode=... — режим задаётся DATABASE_SSL_MODE.
DATABASE_URL=postgresql+asyncpg://USER:URL_ENCODED_PASSWORD@HOST:5432/DBNAME
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_ROOT_CERT=~/.cloud-certs/root.crt
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- Бюджет соединений -------------------------------------------------------
# У управляемой БД лимит соединений один на всех, а процессов у нас много:
# api, bot, prefect-worker и до восьми параллельных флоу подписчиков внутри
# него. Поэтому пул маленький и жёстко ограничен: DB_POOL_SIZE + DB_MAX_OVERFLOW
# не должно превышать DB_CONNECTION_BUDGET — иначе приложение не стартует, и
# это лучше, чем упереться в лимит под нагрузкой.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_CONNECTION_BUDGET=2
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
DB_APPLICATION_NAME=geonexa-proxima

# Схема при старте контейнера: чистая база поднимается сама.
DB_AUTO_MIGRATE=true
DB_AUTO_SEED=true
DB_WAIT_ATTEMPTS=30
DB_WAIT_DELAY_SECONDS=2.0
# psql-эквивалент для ручных проверок:
#   PGSSLROOTCERT=~/.cloud-certs/root.crt psql 'postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/default_db?sslmode=verify-full'

# --- Локальный PostgreSQL (профиль compose local-db, только для разработки) ---
POSTGRES_DB=geonexa
POSTGRES_USER=geonexa
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Векторное хранилище -----------------------------------------------------
# Векторы лежат в основной БД: запись материала и его вектора идёт одной
# транзакцией, рассинхронизации между двумя хранилищами не существует.
VECTOR_BACKEND=pgvector
# vector до 2000 измерений в индексе, halfvec до 4000 (нужен pgvector 0.7+)
VECTOR_COLUMN_TYPE=vector
VECTOR_INDEX_KIND=hnsw
VECTOR_HNSW_M=16
VECTOR_HNSW_EF_CONSTRUCTION=64
VECTOR_HNSW_EF_SEARCH=80
VECTOR_IVFFLAT_LISTS=100

# --- Локальные веса моделей --------------------------------------------------
# Каталог с qwen3-emb-0.6b и qwen3-rerank-0.6b. В образ веса не пекутся:
# в compose каталог монтируется внутрь контейнера только на чтение.
# Модель ищется по содержимому каталога, а не только по имени.
MODELS_ROOT=models

# Qdrant остаётся за портом VectorStore: переезд стоит одного адаптера
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=geonexa_items
QDRANT_PROFILE_COLLECTION=geonexa_profiles
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Prefect (self-hosted server в docker-compose) ---------------------------
PREFECT_API_URL=http://localhost:4200/api
PREFECT_API_KEY=
PREFECT_SERVER_PORT=4200
PREFECT_POSTGRES_DB=prefect
PREFECT_POSTGRES_USER=prefect
PREFECT_POSTGRES_PASSWORD=change-me
PREFECT_WORK_POOL=geonexa-pool
PREFECT_WORK_QUEUE=default
# Метаданные Prefect живут в своей БД. По умолчанию — контейнер prefect-postgres
# в compose: у управляемой БД Timeweb выдана одна база default_db, а Prefect
# требует отдельную. Заведёшь вторую базу в панели Timeweb — подставь её DSN.
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://prefect:change-me@localhost:5433/prefect
# Дефолтные расписания при первом bootstrap; дальше — из БД/админки
SCHEDULE_GLOBAL_HARVEST_CRON=0 3 * * *
SCHEDULE_DIGEST_DISPATCH_CRON=0 7 * * 1
SCHEDULE_DIGEST_DISPATCH_CHATS_CRON=30 7 * * 1
SCHEDULE_DELIVERY_PERSONAL_CRON=*/5 * * * *
SCHEDULE_DELIVERY_GROUP_CRON=*/5 * * * *
SCHEDULE_CHAT_MONITOR_CRON=0 */6 * * *
SCHEDULE_MAINTENANCE_CRON=30 4 * * *
SCHEDULE_SUBSCRIPTION_MAINTENANCE_CRON=0 5 * * *

# --- Админка: доступ ---------------------------------------------------------
# ADMIN_PASSWORD — plaintext для dev. Для production задай ADMIN_PASSWORD_HASH
# (argon2) и оставь ADMIN_PASSWORD пустым: hash имеет приоритет.
# Внешний адрес админки. Без него SvelteKit отвергает POST-формы как
# CSRF, и вход перестаёт работать без единого сообщения об ошибке.
ADMIN_ORIGIN=http://localhost:3000
ADMIN_UI_PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=generate-with-openssl-rand-base64-48
ADMIN_JWT_TTL_MINUTES=720
ADMIN_REFRESH_TTL_DAYS=14
ADMIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5

# Ключ шифрования API-ключей провайдеров, добавленных через админку (Fernet).
# Смена ключа делает сохранённые в БД ключи нечитаемыми.
SECRET_ENCRYPTION_KEY=generate-with-python-fernet-generate-key

# --- LLM: общий провайдер по умолчанию (DeepSeek) ----------------------------
# OpenAI-совместимый эндпоинт. Модели: deepseek-v4-flash | deepseek-v4-pro.
# reasoning_effort: low | high | max  (thinking включён по умолчанию).
# Эти значения сидируются в llm_providers/llm_models/llm_role_bindings и
# дальше правятся в админке; свои провайдеры добавляются там же.
DEFAULT_LLM_PROVIDER_KEY=deepseek
DEFAULT_LLM_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_API_KEY=replace-me

# Лёгкая модель: массовые операции (глобальный скоринг, объяснения, компиляция профилей)
LIGHT_LLM_BASE_URL=https://api.deepseek.com/v1
LIGHT_LLM_API_KEY=replace-me
LIGHT_LLM_MODEL=deepseek-v4-flash
LIGHT_LLM_REASONING_EFFORT=low
LIGHT_LLM_TEMPERATURE=0.1
LIGHT_LLM_MAX_TOKENS=2048
LIGHT_LLM_JSON_MODE=true
LIGHT_LLM_CONCURRENCY=8

# Тяжёлая модель: глубокий разбор единичных материалов
HEAVY_LLM_BASE_URL=https://api.deepseek.com/v1
HEAVY_LLM_API_KEY=replace-me
HEAVY_LLM_MODEL=deepseek-v4-flash
HEAVY_LLM_REASONING_EFFORT=high
HEAVY_LLM_TEMPERATURE=0.2
HEAVY_LLM_MAX_TOKENS=8192
HEAVY_LLM_JSON_MODE=true
HEAVY_LLM_CONCURRENCY=2

LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
LLM_LOG_CALLS=true
LLM_DAILY_TOKEN_BUDGET=0

# --- Embeddings --------------------------------------------------------------
# ВНИМАНИЕ: DeepSeek не отдаёт embeddings. Нужен отдельный провайдер.
# local — веса в models/ (см. README), api — OpenAI-совместимый /v1/embeddings.
EMBEDDING_MODE=local
EMBEDDING_LOCAL_PATH=models/Qwen3-Embedding-0.6B
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_API_BASE_URL=http://localhost:8001/v1
EMBEDDING_API_KEY=
# 0.6B даёт ровно 1024; Matryoshka режет вниз, но не удлиняет.
# Апгрейд до 4B (2560) расписан в README.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
# Запросы подаются с инструкцией, документы — без неё. Это требование модели,
# а не украшение промпта: асимметрия заложена в обучение.
EMBEDDING_INSTRUCTION_ENABLED=true
EMBEDDING_QUERY_INSTRUCTION=Given a research profile in geotechnics, engineering geology and machine learning, retrieve scientific papers, methods, software and datasets that match this profile

# --- Reranker ----------------------------------------------------------------
RERANKER_MODE=local
RERANKER_LOCAL_PATH=models/Qwen3-Reranker-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_API_URL=http://localhost:8002/rerank
RERANKER_API_KEY=
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=8192
RERANKER_INSTRUCTION=Given a research profile in geotechnics, engineering geology and machine learning, retrieve scientific papers, methods, software and datasets that match this profile

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=replace-me
# Владельцы: полный доступ к боту независимо от подписки. Через запятую.
TELEGRAM_OWNER_IDS=
# Кого пускать в режиме allowlist/invite. Через запятую.
# В режиме allowlist пустой список означает «пускать всех»: иначе свежая
# установка молча не отвечала бы даже владельцу. Сервис предупреждает об этом
# в логе при старте.
TELEGRAM_ALLOWED_USER_IDS=
# open — отвечать всем; allowlist — списку выше (пустой = всем);
# invite — строго списку выше. Владельцы проходят при любом режиме.
TELEGRAM_REGISTRATION_MODE=allowlist
# Разрешать боту работать в группах и каналах, куда его добавили.
TELEGRAM_ALLOW_GROUP_CHATS=true
# Заводить чат подписчиком по апдейту my_chat_member. Выключишь — бота в чат
# добавят, а в базе он не появится, и рассылать туда будет нечего.
TELEGRAM_AUTO_REGISTER_CHATS=true
# Локальная разработка: polling. Production: webhook.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=generate-with-openssl-rand-base64-32
# Лимиты Bot API: ~30 сообщений/сек глобально, 1/сек в чат, 20/мин в группу
TELEGRAM_GLOBAL_RATE_PER_SECOND=25
TELEGRAM_CHAT_RATE_PER_SECOND=1
TELEGRAM_GROUP_RATE_PER_MINUTE=18

# --- Доставка ----------------------------------------------------------------
DELIVERY_BATCH_SIZE=50
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BACKOFF_SECONDS=60
DELIVERY_JOB_TTL_HOURS=72
DELIVERY_DRY_RUN=false

# --- Harvest -----------------------------------------------------------------
HARVEST_PROFILE_KEY=geo_ai_core
HARVEST_CONFIG_PATH=config/harvest.yaml
TAXONOMY_PATH=config/taxonomy.yaml
COLLECTION_LOOKBACK_HOURS=192
MAX_ITEMS_PER_SOURCE=300
HARVEST_KEYWORD_THRESHOLD=0.35
HARVEST_STORE_REJECTED=true
HARVEST_DECISION_RETENTION_DAYS=90
# Через сколько минут «выполняющийся» прогон считать оборванным и закрыть.
# Одновременно идёт только один сбор; незакрытая запись блокирует все следующие.
HARVEST_RUN_STALE_MINUTES=90

# --- Пороги пайплайна --------------------------------------------------------
SEMANTIC_THRESHOLD=0.45
DIGEST_SCORE_THRESHOLD=6.5
DEEP_ANALYSIS_THRESHOLD=8.0
ALERT_SCORE_THRESHOLD=9.0
PERSONALIZATION_CANDIDATE_LIMIT=100
PERSONAL_SEMANTIC_WEIGHT=0.40
PERSONAL_RERANKER_WEIGHT=0.25
PERSONAL_GLOBAL_WEIGHT=0.25
PERSONAL_INTEREST_WEIGHT=0.10

# --- Подписки ----------------------------------------------------------------
DEFAULT_SUBSCRIPTION_PLAN=free
# Как часто дайджест уходит подписчику без действующего тарифа.
DIGEST_DEFAULT_INTERVAL_HOURS=168
DEFAULT_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=3

# --- Источники: идентификация и квоты ----------------------------------------
OPENALEX_EMAIL=researcher@example.com
CROSSREF_EMAIL=researcher@example.com
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
HF_TOKEN=

# --- Порты сервисов ----------------------------------------------------------
API_PORT=8000

# --- Админка на SvelteKit ----------------------------------------------------
# Переменные с префиксом PUBLIC_ доступны клиенту через $env/static/public,
# остальные — только серверным load-функциям через $env/static/private.
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_APP_NAME=Проксима
PUBLIC_APP_TAGLINE=Глобальный сервис Геонекса
ORIGIN=http://localhost:5173
API_INTERNAL_URL=http://api:8000
NODE_ENV=development

# --- Метрики и аналитика -----------------------------------------------------
METRICS_ENABLED=true
METRICS_TIMEZONE=Europe/Moscow
METRICS_ROLLUP_CRON=15 * * * *
METRICS_RETENTION_DAYS=730
METRICS_ACTIVE_WINDOW_DAYS=30
METRICS_COHORT_WEEKS=12
METRICS_ROLLUP_LOOKBACK_DAYS=3
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics

# --- Локальный стенд (docker-compose.dev.yml) --------------------------------
# Стенд читает эти переменные вместо production-аналогов: значения выше
# описывают прод, и подставлять их в docker-compose.dev.yml нельзя — например,
# EMBEDDING_MODE=local требует образа, собранного с INSTALL_ML=true.
INSTALL_ML=false
DEV_EMBEDDING_MODE=api
DEV_RERANKER_MODE=api
# Пачки и окно реранкера для ноутбука: production-значения рассчитаны на сервер.
DEV_EMBEDDING_BATCH_SIZE=8
DEV_RERANKER_BATCH_SIZE=2
DEV_RERANKER_MAX_LENGTH=2048
DEV_MAX_ITEMS_PER_SOURCE=50
DEV_DELIVERY_DRY_RUN=true
DEV_PUBLIC_BASE_URL=http://localhost:8000
DEV_API_PORT=8000
DEV_ADMIN_UI_PORT=5173
DEV_PREFECT_PORT=4200
DEV_POSTGRES_PORT=5432
DEV_POSTGRES_USER=geonexa
DEV_POSTGRES_PASSWORD=geonexa
DEV_POSTGRES_DB=geonexa
DEV_PREFECT_POSTGRES_PASSWORD=prefect
DEV_ADMIN_ORIGIN=http://localhost:5173
DEV_PUBLIC_API_BASE_URL=http://localhost:8000
